# Optional settings. Copy to .env to use them — Workbench runs fine without this file.

# Your domain, to turn on automatic HTTPS:  docker compose --profile https up -d
WORKBENCH_DOMAIN=

# With HTTPS on, keep the app port private to the server:
# WORKBENCH_BIND=127.0.0.1
# WORKBENCH_PORT=8000

# Use PostgreSQL instead of the built-in SQLite database (large teams only):
# WORKBENCH_DB_NAME=workbench
# WORKBENCH_DB_USER=workbench
# WORKBENCH_DB_PASSWORD=
# WORKBENCH_DB_HOST=db

# Web server worker processes (default 3)
# WORKBENCH_WORKERS=3

# --- Where uploaded files are stored (default: data/files on this server) ---
# A different folder/disk (mount it into the container first):
# WORKBENCH_FILES_DIR=/files
# Amazon S3 or S3-compatible storage:
# WORKBENCH_STORAGE=s3
# WORKBENCH_S3_BUCKET=
# WORKBENCH_S3_REGION=
# WORKBENCH_S3_PREFIX=workbench
# WORKBENCH_S3_ACCESS_KEY_ID=          # omit on AWS when using an IAM role
# WORKBENCH_S3_SECRET_ACCESS_KEY=
# WORKBENCH_S3_ENDPOINT_URL=           # only for non-AWS services (Wasabi, R2, MinIO…)
