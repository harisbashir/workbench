# Copy to .env and fill in. Never commit the real .env file.

# --- Required in production -------------------------------------------------
WORKBENCH_SECRET_KEY=change-me-to-a-long-random-string
WORKBENCH_ALLOWED_HOSTS=workbench.example.com
WORKBENCH_CSRF_TRUSTED_ORIGINS=https://workbench.example.com
WORKBENCH_SITE_URL=https://workbench.example.com
# Separate key for encrypting two-factor secrets (Fernet key, 32 url-safe base64 bytes).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKBENCH_FIELD_KEY=
# Shared secret for the GitHub webhook. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
WORKBENCH_GITHUB_WEBHOOK_SECRET=

# --- Database (PostgreSQL). Leave WORKBENCH_DB_NAME empty to use SQLite. ----
WORKBENCH_DB_NAME=workbench
WORKBENCH_DB_USER=workbench
WORKBENCH_DB_PASSWORD=
WORKBENCH_DB_HOST=db
WORKBENCH_DB_PORT=5432

# --- Optional ---------------------------------------------------------------
WORKBENCH_COMPANY_NAME=Workbench
WORKBENCH_TIME_ZONE=UTC
WORKBENCH_DEBUG=0
WORKBENCH_REQUIRE_MFA=1
WORKBENCH_SESSION_HOURS=12
WORKBENCH_LOGIN_MAX_ATTEMPTS=5
WORKBENCH_LOGIN_LOCKOUT_MINUTES=15
WORKBENCH_MAX_UPLOAD_MB=25
